# Configuración de la API de Votación
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
DEBUG=True

# URLs de las instancias del servicio a evaluar (separadas por coma)
SERVICE_INSTANCES=http://localhost:8001,http://localhost:8002,http://localhost:8003

# Timeout en segundos para la respuesta de cada réplica
VOTING_TIMEOUT_SECONDS=3.0

# Llave secreta para JWT
JWT_SECRET_KEY=llave-secreta-jwt-componente-votacion-2026
